{
  "name": "@obinexusltd/rust-polycall",
  "version": "2.0.0",
  "description": "Rust source binding for the Polycall C library (binding ABI v1)",
  "main": "index.js",
  "type": "commonjs",
  "exports": {
    ".": "./index.js",
    "./package.json": "./package.json",
    "./Cargo.toml": "./Cargo.toml",
    "./Cargo.lock": "./Cargo.lock",
    "./build.rs": "./build.rs",
    "./src/*": "./src/*",
    "./dist/*": "./dist/*",
    "./examples/*": "./examples/*",
    "./tests/*": "./tests/*",
    "./config": "./rust-polycallrc",
    "./manifest": "./polycall-binding.json"
  },
  "files": [
    "index.js",
    "Cargo.toml",
    "Cargo.lock",
    "build.rs",
    "src/",
    "dist/",
    "examples/",
    "tests/",
    "rust-polycallrc",
    "polycall-binding.json",
    "README.md",
    "TODO.md",
    "LICENSE"
  ],
  "directories": {
    "lib": "src",
    "src": "src",
    "dist": "dist",
    "example": "examples",
    "test": "tests"
  },
  "scripts": {
    "build": "cargo build --all-targets",
    "test": "cargo test && cargo clippy --all-targets -- -D warnings && node tests/package.test.js && node tests/source.test.js",
    "test:rust": "cargo test",
    "test:package": "node tests/package.test.js",
    "test:source": "node tests/source.test.js",
    "verify": "npm test",
    "prepack": "node tests/package.test.js && node tests/source.test.js"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/obinexus/rust-polycall.git"
  },
  "keywords": [
    "polycall",
    "rust",
    "ffi",
    "binding",
    "peer-to-peer"
  ],
  "author": "Nnamdi Michael Okpala <okpalan@protonmail.com>",
  "license": "MIT",
  "engines": {
    "node": ">=18",
    "npm": ">=9"
  },
  "publishConfig": {
    "access": "public"
  },
  "bugs": {
    "url": "https://github.com/obinexus/rust-polycall/issues"
  },
  "homepage": "https://github.com/obinexus/rust-polycall#readme",
  "polycall": {
    "core": "polycall >= 1.1.0 (binding ABI 1)",
    "coreRepository": "https://github.com/obinexus/polycall"
  }
}
