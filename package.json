{
  "name": "@obinexusltd/rust-polycall",
  "version": "1.0.0",
  "description": "Rust source binding for libpolycall 1.5",
  "main": "index.js",
  "type": "commonjs",
  "exports": {
    ".": "./index.js",
    "./package.json": "./package.json",
    "./Cargo.toml": "./Cargo.toml",
    "./Cargo.lock": "./Cargo.lock",
    "./build.rs": "./build.rs",
    "./src/*": "./src/*",
    "./dist/*": "./dist/*",
    "./examples/*": "./examples/*",
    "./tests/*": "./tests/*",
    "./config": "./rust-polycallrc",
    "./manifest": "./polycall-binding.json"
  },
  "files": [
    "index.js",
    "Cargo.toml",
    "Cargo.lock",
    "build.rs",
    "src/",
    "dist/",
    "examples/",
    "tests/",
    "rust-polycallrc",
    "polycall-binding.json",
    "README.md",
    "TODO.md",
    "LICENSE"
  ],
  "directories": {
    "lib": "src",
    "src": "src",
    "dist": "dist",
    "example": "examples",
    "test": "tests"
  },
  "scripts": {
    "build": "cargo build --lib",
    "test": "cargo test --lib && cargo check --example demo && node tests/package.test.js && node tests/source.test.js",
    "test:rust": "cargo test --lib",
    "test:package": "node tests/package.test.js",
    "test:source": "node tests/source.test.js",
    "verify": "npm test",
    "prepack": "npm test"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/obinexus/rust-polycall.git"
  },
  "keywords": [
    "libpolycall",
    "polycall",
    "rust",
    "ffi",
    "native"
  ],
  "author": "Nnamdi Michael Okpala <okpalan@protonmail.com>",
  "license": "MIT",
  "engines": {
    "node": ">=18",
    "npm": ">=9"
  },
  "publishConfig": {
    "access": "public"
  },
  "bugs": {
    "url": "https://github.com/obinexus/rust-polycall/issues"
  },
  "homepage": "https://github.com/obinexus/rust-polycall#readme"
}
