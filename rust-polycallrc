# rust-polycallrc - Rust runtime overrides for Polycall
#
# Grammar: the core's own configuration loader -- exactly what
# `polycall config validate rust-polycallrc` and
# polycall_ffi_run_config(path, run) accept (see the core's
# docs/BINDING_ABI.md and docs/CONFIGURATION_STANDARD.md). This binding adds
# no keys and no parser: rust_polycall::run_config(Some(path), true) passes
# the path to the core, which treats unknown keys as errors in that mode.

log_level=info
max_connections=1000
network_timeout=5000
tls_enabled=false
